#!/usr/bin/env bash
# bd-gfx - better-dev's shared graphify helpers.
#   source it:  . "${CLAUDE_PLUGIN_ROOT}/scripts/bd-gfx"
#          or:  . "$repo/.better-dev/bin/bd-gfx"
# Repo-keyed central home holds the registry AND every graph: output lives
# OUTSIDE the tree it indexes, one dir per worktree per domain (gfx_out_dir), so
# a build never writes into the repo it is reading.
# Ported from orrgal1/claude-plugins graphify-wrapper (MIT), see NOTICE.

# Canonical repo id, stable across all worktrees (derived from git identity).
gfx_repo_key() {
  local url
  url=$(git remote get-url origin 2>/dev/null || true)
  if [ -n "$url" ]; then
    printf '%s\n' "$url" | sed -E \
      -e 's#\.git$##' \
      -e 's#^[a-z]+://##' \
      -e 's#^[^@]*@##' \
      -e 's#^[^:/]*[:/]##' \
      -e 's#/#__#g'
  else
    # No origin: key on this repo's own git dir. `--git-common-dir` prints the
    # RELATIVE ".git" from a main worktree, so hashing what it prints collapsed
    # every remote-less repo on the machine into ONE key - one shared registry,
    # one shared home, repo A's domains listed and resolved as repo B's. Resolve
    # it to an absolute path first: that is what makes the key per-repo.
    local gd
    gd=$(git rev-parse --git-common-dir 2>/dev/null) || gd=
    if [ -n "$gd" ]; then gd=$(cd "$gd" 2>/dev/null && pwd -P) || gd=; fi
    printf '%s' "$gd" | shasum -a 256 | cut -c1-12
  fi
}

# Central home for this repo: the registry AND every graph built from any of its
# worktrees (out of tree - see gfx_out_dir). Override with GRAPHIFY_HOME.
#
# Fails closed, printing no path at all, when the home would sit INSIDE the tree
# being indexed. A dotfiles repo checked out at $HOME, or CI with HOME set to the
# workspace, otherwise writes the registry and every graph into the repo, and no
# gitignore stands between that and a commit any more. There is no safe fallback
# to invent - where HOME is the repo, every default is in the repo - so this
# refuses and names the override. The refusal lives here rather than at each write
# site, so that everything derived from the home (registry, out dirs) is safe by
# construction rather than by remembering.
#
# Decided on PHYSICAL paths: git's toplevel is `pwd -P` while $HOME is routinely a
# symlink, and the raw strings would read "outside" for a home provably inside.
# The home need not exist yet, so its deepest existing ancestor answers it: the
# worktree does exist, so an ancestor inside it is the same answer.
gfx_home() {
  local home wt base
  home="${GRAPHIFY_HOME:-$HOME/.claude/graphify/$(gfx_repo_key)}"
  wt=$(gfx_this_worktree)
  if [ -n "$wt" ]; then
    base=$home
    while [ ! -d "$base" ]; do
      case "$base" in */?*) base=${base%/*}; [ -n "$base" ] || base=/ ;; *) break ;; esac
    done
    base=$(cd "$base" 2>/dev/null && pwd -P) || base=$home
    case "$base/" in "$wt/"*)
      printf 'graphify home %s is inside the tree it indexes (%s) - set GRAPHIFY_HOME to a directory outside it\n' \
        "$home" "$wt" >&2
      return 1 ;;
    esac
  fi
  printf '%s\n' "$home"
}
gfx_registry() { local h; h=$(gfx_home) || return 1; printf '%s/registry.json\n' "$h"; }

# Path of the current worktree root.
gfx_this_worktree() { git rev-parse --show-toplevel 2>/dev/null; }

# Absolute output dir for one domain in THIS worktree, always OUTSIDE the indexed
# tree:  gfx_out_dir [name]  ->  <home>/worktrees/<worktree key>[/<name>].
# Every read and write site derives from this, and a build exports it as
# GRAPHIFY_OUT. graphify honours an ABSOLUTE GRAPHIFY_OUT in extract, update,
# watch, query, the cache and its path guard (paths.py:26), but an absolute value
# is ONE destination for every repo indexed under it, so it is exported per
# invocation with this per-worktree, per-domain value - never set once globally.
# The worktree key hashes the worktree's absolute path: stable across sessions (a
# checkout does not move) and distinct per worktree. Deliberately not the branch
# name - a branch is renamed and moves between worktrees, and the graph would
# follow it into the wrong tree. A path is a LOCATION, not an identity, so what is
# found there is vouched for by provenance before it is served (gfx_graph_state).
# The key carries no machine component either: two machines sharing one home over
# NFS with the repo checked out at the same absolute path write to one dir and
# refresh against each other's provenance forever. Give each machine its own
# GRAPHIFY_HOME there.
gfx_out_dir() {
  local wt home
  wt=$(gfx_this_worktree)
  [ -n "$wt" ] || return 1
  # The domain name is interpolated into a filesystem path, so it is checked
  # before it gets there: a name carrying `/` or `..` resolves the output back OUT
  # of the home and possibly into a repo - the one thing this helper exists to
  # prevent - and it is what the `rm -rf` of a foreign output dir would delete.
  case "${1:-}" in
    *[!A-Za-z0-9._-]*|*..*)
      printf 'invalid domain name "%s" - letters, digits, dot, underscore and dash only\n' "$1" >&2
      return 1 ;;
  esac
  home=$(gfx_home) || return 1        # refuses outright when it is inside $wt
  printf '%s/worktrees/%s%s\n' "$home" \
    "$(printf '%s' "$wt" | shasum -a 256 | cut -c1-12)" "${1:+/$1}"
}

# How the graph at $1 stands to the tree checked out here:
#   gfx_graph_state <graph.json> [domain path]
#     0 - it describes this tree: serve it
#     1 - stale for that domain: refresh in place (`graphify update` is diff-aware,
#         so the semantic layer survives an AST refresh)
#     2 - another tree's output: discard the whole dir and build cold
#
# gfx_out_dir keys on the worktree's PATH, so output now OUTLIVES the tree it
# describes: /worktree-branching names worktrees .claude/worktrees/feat+<slug> and
# /pr-and-verify removes them after merge, so a retried item, or any second item
# on the same slug, recreates that exact path and finds the previous occupant's
# graph sitting there. It parses, so a torn-graph check waves it through, and "who
# calls this" gets answered about a codebase that no longer exists.
#
# A path is a location, so the answer cannot come from it - it comes from the
# provenance graphify stamps (`built_at_commit`) measured against the tree that is
# here now. A commit this repo does not have is another repo's (a worktree deleted
# and re-created at the same path, a fresh checkout over the top), and so is a
# graph carrying no provenance at all: nothing to reconcile, discard it. Otherwise
# the graph is accurate exactly while the delta from its commit to HEAD leaves the
# domain untouched - which is the same rule the background refresh hook applies,
# now applied by the query path too, synchronously, because that is the one the
# operator reads an answer off. Identical trees at a different commit are still
# this tree, and cost nothing to serve.
#
# An unborn HEAD compares equal to an unstamped graph, so a repo with no commits
# converges on serving rather than rebuilding at every question.
gfx_graph_state() {
  local graph="$1" idx_path="${2:-.}" built head top
  built=$(jq -r '.built_at_commit // empty' "$graph" 2>/dev/null) || return 2
  head=$(git rev-parse HEAD 2>/dev/null) || head=
  [ "$built" = "$head" ] && return 0
  { [ -n "$built" ] && [ -n "$head" ]; } || return 2
  git rev-parse --verify -q "$built^{commit}" >/dev/null 2>&1 || return 2
  # Pathspec resolved from the worktree root, never from the caller's cwd, or a
  # question asked from a subdirectory reads "nothing changed" for the whole repo.
  top=$(gfx_this_worktree)
  [ -n "$(git -C "${top:-.}" diff --name-only "$built" "$head" -- "$idx_path" 2>/dev/null)" ] \
    || return 0
  return 1
}

# Reclaim output dirs whose worktree is gone:  gfx_reap
#
# The worktree key is a one-way hash of a path, so nothing can name an orphan dir
# from outside the worktree that made it - and that worktree is exactly what has
# been deleted. So the dir names itself, through the `.graphify_root` graphify
# writes beside every graph: the absolute path it indexed. Without this, every
# merged and torn-down feature branch leaves its whole output (graph, html,
# report, cache, retrieval memory) under the home forever, unreferenced by any
# registry entry and unlisted by any status verb.
#
# Liveness is git's answer, not the path's existence: a branch checked out in a
# live worktree may simply not carry a domain's subtree today, and deleting that
# domain's graph would cost a rebuild (plan-billed for a semantic one) for nothing.
# Every dir under this home belongs to a worktree of THIS repo, so a recorded root
# inside any worktree git still lists is in use. Removes nothing anywhere else.
gfx_reap() {
  local home d root w live alive
  home=$(gfx_home) || return 0
  [ -d "$home/worktrees" ] || return 0
  live=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  [ -n "$live" ] || return 0                    # cannot tell what is live: reap nothing
  for d in "$home"/worktrees/*/*; do
    [ -d "$d" ] || continue
    root=$(cat "$d/.graphify_root" 2>/dev/null) || continue
    [ -n "$root" ] || continue
    alive=0
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      case "$root/" in "$w/"*) alive=1; break ;; esac
    done <<EOF
$live
EOF
    [ "$alive" = 0 ] || continue
    rm -rf "$d" && printf 'graphify: reaped %s (its worktree is gone)\n' "$d" >&2
  done
  rmdir "$home"/worktrees/*/ 2>/dev/null || true   # worktree keys left with no domain
}

# Backend for --semantic builds; defaults to claude-cli (no API key, plan-billed).
gfx_backend() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.backend // "claude-cli"' "$r" 2>/dev/null && return 0
  fi
  printf 'claude-cli\n'
}

# Model for the claude-cli semantic backend. graphify's claude-cli path defaults
# to Opus (overkill for structured-JSON extraction); we pin sonnet.
gfx_cli_model() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.cli_model // "sonnet"' "$r" 2>/dev/null && return 0
  fi
  printf 'sonnet\n'
}

# File globs excluded from semantic `extract`. graphify reads docs AND images as
# text and asks the LLM to graph them, but SVG markup (path/base64 data) and
# decoded binary bytes are token-heavy noise with zero architectural signal, and
# big image-stuffed chunks are what time out. Default to dropping image/asset
# files; override per-repo with a JSON `.extract_excludes` array in the registry.
gfx_extract_excludes() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ] && jq -e '(.extract_excludes // empty) | type == "array"' "$r" >/dev/null 2>&1; then
    jq -r '.extract_excludes[]' "$r" 2>/dev/null && return 0
  fi
  printf '%s\n' '*.svg' '*.png' '*.jpg' '*.jpeg' '*.gif' '*.webp' '*.bmp' '*.ico' '*.tiff' '*.heic'
}

# Per-chunk token budget for the claude-cli backend. graphify hardcodes the
# `claude -p` subprocess timeout at 600s (--api-timeout governs only HTTP API
# backends), so oversized chunks time out. Cap chunk size below graphify's 60k
# default so each call finishes under the wall. Override with `.cli_token_budget`.
gfx_cli_token_budget() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.cli_token_budget // "20000"' "$r" 2>/dev/null && return 0
  fi
  printf '20000\n'
}

# jq read of an index field:  gfx_index_field <name> <field>
gfx_index_field() {
  jq -r --arg n "$1" --arg f "$2" '.indexes[$n][$f] // empty' "$(gfx_registry)" 2>/dev/null
}

gfx_index_names() { jq -r '.indexes | keys[]' "$(gfx_registry)" 2>/dev/null; }

# Resolve a queryable graph, building whatever is missing. Prints the graph.json
# path on stdout, every diagnostic on stderr, so a caller can capture the path.
#
# This exists because the query path used to dead-end: it exited 1 on a missing
# registry, a missing domain, or a missing graph, and the caller silently fell
# back to grep. Three misses down that chain and no repo ever built a graph at
# all, so the capability shipped and never ran. Each miss is now healed in place
# - the first real question is what wires the index up.
#
# The build here is always AST-only: free, no LLM, no API key. A `--semantic`
# layer stays a deliberate `/graphify-wrapper-sync --semantic`, never something
# a question triggers on the operator's behalf.
gfx_ensure_graph() {
  local name="${1:-}" reg root idx_path dst out graph tmp why state
  command -v graphify >/dev/null 2>&1 || {
    printf 'graphify CLI not installed - run /graphify-wrapper-setup\n' >&2; return 1; }
  root=$(gfx_this_worktree)
  [ -n "$root" ] || { printf 'not inside a git worktree\n' >&2; return 1; }
  reg=$(gfx_registry) || return 1     # the home refuses to sit inside the tree it indexes

  # Miss 1 - no registry: setup never ran here. Write the one it would have.
  if [ ! -f "$reg" ]; then
    mkdir -p "$(dirname "$reg")" || return 1
    jq -n --arg key "$(gfx_repo_key)" \
      '{repo_key:$key, backend:"claude-cli", cli_model:"sonnet", indexes:{}}' \
      > "$reg" || return 1
    printf 'graphify: created registry %s\n' "$reg" >&2
  fi

  # Miss 2 - nothing carved: index the whole repo as one domain so the question
  # can be answered now. /graphify-wrapper-map carves it properly once the repo
  # is big enough to earn the split.
  if [ -z "$(gfx_index_names)" ]; then
    [ -n "$name" ] || name=repo
    tmp=$(mktemp "$(dirname "$reg")/.reg.XXXXXX") || return 1
    if jq --arg n "$name" '.indexes[$n]={path:".", semantic:false}' "$reg" > "$tmp"; then
      mv "$tmp" "$reg" || { rm -f "$tmp"; return 1; }
    else
      rm -f "$tmp"; return 1
    fi
    printf 'graphify: no domain registered - indexing the whole repo as "%s" (carve it later with /graphify-wrapper-map)\n' "$name" >&2
  fi

  [ -n "$name" ] || name=$(gfx_index_names | head -1)
  idx_path=$(gfx_index_field "$name" path)
  [ -n "$idx_path" ] || { printf 'unknown index "%s" - see /graphify-wrapper-status\n' "$name" >&2; return 1; }
  case "$idx_path" in .) dst="$root" ;; *) dst="$root/$idx_path" ;; esac
  [ -d "$dst" ] || { printf 'index "%s" path absent in this worktree: %s\n' "$name" "$idx_path" >&2; return 1; }
  out=$(gfx_out_dir "$name") || return 1
  graph="$out/graph.json"

  # Miss 3 - no USABLE graph for this worktree. Three states are not one, and none
  # of them is served. (a) Torn graph.json: graphify's shrink guard refuses
  # `update` over one it cannot parse, so the file goes and the cache stays. (b)
  # Another tree's output, because the out dir outlives the worktree it is keyed
  # on: it parses, so only provenance sees it, and the whole dir goes with it -
  # cache and retrieval memory included, all of it describing a tree that is gone.
  # (c) Stale for this domain: refreshed in place, which is incremental and keeps
  # any semantic layer. Serving a graph of the previous occupant's codebase is the
  # defect; a rebuild is the correct cost.
  why=; state=0
  if [ ! -f "$graph" ]; then why='none here yet'
  elif ! jq -e . "$graph" >/dev/null 2>&1; then why='the graph here is torn'; rm -f "$graph"
  else
    gfx_graph_state "$graph" "$idx_path" || state=$?
    case "$state" in
      2) why='a different tree built the graph here'; rm -rf "$out" ;;
      1) why='stale for commits that touched this domain' ;;
    esac
  fi
  if [ -n "$why" ]; then
    printf 'graphify: AST build for "%s" (%s) - no LLM\n' "$name" "$why" >&2
    GRAPHIFY_OUT="$out" graphify update "$dst" >&2 \
      || { printf 'graphify build failed for "%s"\n' "$name" >&2; return 1; }
  fi
  jq -e . "$graph" >/dev/null 2>&1 || { printf 'graph still unusable after build: %s\n' "$graph" >&2; return 1; }
  printf '%s\n' "$graph"
}

# Links whose two endpoints live in different top-level subtrees of the indexed
# path:  gfx_cross_edges <graph.json>  -> one integer on stdout. A cheap read of
# how much a domain's structure crosses its own seams.
#
# Only endpoints that resolve to a subtree count. A node whose source_file has no
# `/` is a root-level file, in no subtree at all, and an endpoint id with no node
# resolves to nothing - counting either inflates the number the operator makes a
# split/keep decision on (this repo's own graph reported 7 where 1 was real). An
# ABSOLUTE source_file splits to a leading empty element, which is no subtree
# either: a graph still carrying them (a pre-normalisation graphify wrote it)
# counts 0 because nothing resolved, not because nothing crosses. `graphify
# update` rewrites the paths relative before sync calls this.
#
# A graph.json that exists is not a graph.json that parses (graphify leaves torn
# output behind on an interrupted build), so this guards first the way
# gfx_ensure_graph does. Missing, torn, or not shaped like a graph -> non-zero
# and nothing on stdout, never a jq diagnostic passed off as a count.
gfx_cross_edges() {
  local graph="${1:-}"
  jq -e . "$graph" >/dev/null 2>&1 || return 1
  jq -r '(reduce .nodes[] as $n ({};
            .[$n.id] = (($n.source_file // "") | split("/")
                        | if length > 1 and .[0] != "" then .[0] else null end))) as $sub
    | [.links[] | select($sub[.source] != null and $sub[.target] != null
                         and $sub[.source] != $sub[.target])] | length' \
    "$graph" 2>/dev/null
}

# --- selftest -------------------------------------------------------------
# Runs only when this file is EXECUTED, never when sourced. Offline checks of
# the helpers above against throwaway git repos and registries under mktemp.
_gfx_selftest() {
  local d rc=0
  d=$(mktemp -d)
  # shellcheck disable=SC2317
  _fail() { printf 'bd-gfx selftest FAIL: %s\n' "$1" >&2; rc=1; }
  _eq() { [ "$2" = "$3" ] || _fail "$1: expected '$3', got '$2'"; }

  # repo key from an ssh remote
  ( cd "$d" && git init -q && git remote add origin git@github.com:acme/mono.git )
  _eq "ssh repo_key" "$( cd "$d" && gfx_repo_key )" "acme__mono"
  # same repo, https remote form yields the same key
  ( cd "$d" && git remote set-url origin https://github.com/acme/mono.git )
  _eq "https repo_key" "$( cd "$d" && gfx_repo_key )" "acme__mono"

  # no-remote repo hashes to a 12-char hex string, and two of them are DISTINCT:
  # `--git-common-dir` prints a relative ".git" from a main worktree, so hashing
  # its output verbatim gave every remote-less repo on the machine one key.
  local nr nr2 key key2
  nr=$(mktemp -d); ( cd "$nr" && git init -q )
  nr2=$(mktemp -d); ( cd "$nr2" && git init -q )
  key=$( cd "$nr" && gfx_repo_key ); key2=$( cd "$nr2" && gfx_repo_key )
  [[ "$key" =~ ^[0-9a-f]{12}$ ]] || _fail "no-remote repo_key: not 12 hex, got '$key'"
  [ "$key" != "$key2" ] || _fail "no-remote repo_key: two repos collapse to one key ($key)"
  rm -rf "$nr" "$nr2"

  # gfx_home honours GRAPHIFY_HOME, else falls under $HOME/.claude/graphify/<key>
  _eq "gfx_home override" "$( cd "$d" && GRAPHIFY_HOME=/tmp/x gfx_home )" "/tmp/x"
  _eq "gfx_home default" "$( cd "$d" && unset GRAPHIFY_HOME; gfx_home )" \
      "$HOME/.claude/graphify/acme__mono"

  # defaults with no registry file present
  local h; h=$(mktemp -d)
  _eq "default backend"       "$( GRAPHIFY_HOME="$h" gfx_backend )"          "claude-cli"
  _eq "default cli_model"     "$( GRAPHIFY_HOME="$h" gfx_cli_model )"        "sonnet"
  _eq "default token_budget"  "$( GRAPHIFY_HOME="$h" gfx_cli_token_budget )" "20000"
  _eq "default excludes[0]"   "$( GRAPHIFY_HOME="$h" gfx_extract_excludes | head -1 )" "*.svg"
  rm -rf "$h"

  # values read from a registry file
  local rh; rh=$(mktemp -d)
  printf '%s\n' '{"backend":"api","indexes":{"a":{"path":"pkg/a"}}}' >"$rh/registry.json"
  _eq "registry backend"     "$( GRAPHIFY_HOME="$rh" gfx_backend )"              "api"
  _eq "registry index_names" "$( GRAPHIFY_HOME="$rh" gfx_index_names )"          "a"
  _eq "registry index_field" "$( GRAPHIFY_HOME="$rh" gfx_index_field a path )"   "pkg/a"
  rm -rf "$rh"

  # backend falls back to claude-cli when the registry carries no backend key
  local bh; bh=$(mktemp -d)
  printf '%s\n' '{"indexes":{}}' >"$bh/registry.json"
  _eq "backend no-key default" "$( GRAPHIFY_HOME="$bh" gfx_backend )" "claude-cli"
  rm -rf "$bh"

  # out_dir: absolute, under the central home (so never inside the indexed tree),
  # distinct per worktree, stable for one worktree across calls, and with no name
  # it prints that worktree's graph base.
  local w1 w2 o1 o2
  w1=$(mktemp -d); w2=$(mktemp -d)
  ( cd "$w1" && git init -q ) && ( cd "$w2" && git init -q )
  o1=$( cd "$w1" && GRAPHIFY_HOME="$d/home" gfx_out_dir api )
  o2=$( cd "$w2" && GRAPHIFY_HOME="$d/home" gfx_out_dir api )
  case "$o1" in "$d/home/worktrees/"*/api) ;; *) _fail "out_dir shape: got '$o1'" ;; esac
  [ "$o1" != "$o2" ] || _fail "out_dir: two worktrees collapse to one output dir ($o1)"
  _eq "out_dir stable across calls" \
      "$( cd "$w1" && GRAPHIFY_HOME="$d/home" gfx_out_dir api )" "$o1"
  _eq "out_dir base with no name" \
      "$( cd "$w1" && GRAPHIFY_HOME="$d/home" gfx_out_dir )" "${o1%/api}"
  # outside a worktree there is no answer, and no in-tree fallback either
  local ng; ng=$(mktemp -d)
  ( cd "$ng" && GRAPHIFY_HOME="$d/home" gfx_out_dir api >/dev/null 2>&1 ) \
    && _fail "out_dir: expected non-zero outside a git worktree"
  # a domain name is part of a path: traversal out of the home is refused, not walked
  ( cd "$w1" && GRAPHIFY_HOME="$d/home" gfx_out_dir '../../../escape' >/dev/null 2>&1 ) \
    && _fail "out_dir: a traversing domain name must be refused"
  rm -rf "$w1" "$w2" "$ng"

  # The home must never sit INSIDE the tree being indexed: a dotfiles repo checked
  # out at $HOME, or CI with HOME set to the workspace, otherwise writes every
  # graph into the repo with nothing left to ignore it. Refuse, and name the
  # override - there is no outside-the-repo default to fall back to here.
  local hr hmsg
  hr=$(mktemp -d); ( cd "$hr" && git init -q )
  ( cd "$hr" && HOME="$hr" GRAPHIFY_HOME= gfx_home >/dev/null 2>&1 ) \
    && _fail "home: a home inside the indexed tree must be refused, not printed"
  ( cd "$hr" && HOME="$hr" GRAPHIFY_HOME= gfx_registry >/dev/null 2>&1 ) \
    && _fail "registry: derived from a refused home, so it must be refused too"
  ( cd "$hr" && HOME="$hr" GRAPHIFY_HOME= gfx_out_dir api >/dev/null 2>&1 ) \
    && _fail "out_dir: derived from a refused home, so it must be refused too"
  hmsg=$( cd "$hr" && HOME="$hr" GRAPHIFY_HOME= gfx_home 2>&1 >/dev/null )
  case "$hmsg" in *GRAPHIFY_HOME*) ;; *) _fail "home: the refusal must name GRAPHIFY_HOME, got '$hmsg'" ;; esac
  ( cd "$hr" && GRAPHIFY_HOME="$hr/.graphs" gfx_out_dir api >/dev/null 2>&1 ) \
    && _fail "out_dir: an explicit GRAPHIFY_HOME inside the indexed tree must be refused"
  # ... and nothing was written into the repo on the way to refusing.
  _eq "a refused home leaves the indexed repo byte-unchanged" \
      "$( cd "$hr" && HOME="$hr" GRAPHIFY_HOME= gfx_ensure_graph >/dev/null 2>&1
          cd "$hr" && git -c core.excludesFile=/dev/null status --porcelain )" ""
  rm -rf "$hr"

  # Provenance against the tree that is here now, not the location it was found
  # at, decides what happens to a graph. Offline: hand-written graph.json, no
  # graphify needed, so this runs everywhere - the gate machine included.
  local pv pc0 pc1 _st
  _state() { local s=0; ( cd "$pv" && gfx_graph_state "$pv/$1" "${2:-.}" ) || s=$?; printf '%s' "$s"; }
  pv=$(mktemp -d)
  ( cd "$pv" && git init -q && mkdir -p api web && printf 'a\n' >api/a.py \
      && printf 'w\n' >web/w.py && git add -A \
      && git -c user.email=t@t -c user.name=t commit -q -m one )
  pc0=$( cd "$pv" && git rev-parse HEAD )
  ( cd "$pv" && printf 'w2\n' >web/w.py && git add -A \
      && git -c user.email=t@t -c user.name=t commit -q -m two )
  pc1=$( cd "$pv" && git rev-parse HEAD )
  printf '{"built_at_commit":"%s","nodes":[],"links":[]}\n' "$pc1" >"$pv/head.json"
  printf '{"built_at_commit":"%s","nodes":[],"links":[]}\n' "$pc0" >"$pv/older.json"
  printf '{"built_at_commit":"%s","nodes":[],"links":[]}\n' \
    "0000000000000000000000000000000000000000" >"$pv/unknown.json"
  printf '{"nodes":[],"links":[]}\n' >"$pv/unstamped.json"
  _eq "graph_state: built at HEAD is this tree's"            "$(_state head.json)"       "0"
  _eq "graph_state: older build, domain untouched, is served" "$(_state older.json api)"  "0"
  _eq "graph_state: older build, domain changed, is stale"    "$(_state older.json web)"  "1"
  _eq "graph_state: a commit unknown here is another tree's"  "$(_state unknown.json)"    "2"
  _eq "graph_state: no provenance is another tree's"          "$(_state unstamped.json)"  "2"
  # A question asked from a subdirectory must see the whole domain's delta.
  _st=0; ( cd "$pv/api" && gfx_graph_state "$pv/older.json" "." ) || _st=$?
  _eq "graph_state: pathspec is repo-relative, not cwd-relative" "$_st" "1"
  rm -rf "$pv"

  # Reaping: a domain dir whose worktree git no longer lists is reclaimed. A live
  # worktree keeps its dirs even for a subtree the current branch does not carry -
  # that is a checkout, not a teardown, and rebuilding it would cost for nothing.
  local rp rlive
  rp=$(mktemp -d); rlive="$rp/live"
  mkdir -p "$rlive" && ( cd "$rlive" && git init -q )
  rlive=$( cd "$rlive" && git rev-parse --show-toplevel )
  mkdir -p "$rp/home/worktrees/aaa/api" "$rp/home/worktrees/bbb/api" "$rp/home/worktrees/ccc/api"
  printf '%s\n' "$rlive"              >"$rp/home/worktrees/aaa/api/.graphify_root"
  printf '%s\n' "$rlive/never/built"  >"$rp/home/worktrees/bbb/api/.graphify_root"
  printf '%s\n' "$rp/removed-wt"      >"$rp/home/worktrees/ccc/api/.graphify_root"
  ( cd "$rlive" && GRAPHIFY_HOME="$rp/home" gfx_reap ) 2>/dev/null
  [ -d "$rp/home/worktrees/aaa/api" ] || _fail "reap: removed a live worktree's graph"
  [ -d "$rp/home/worktrees/bbb/api" ] \
    || _fail "reap: removed a graph for a subtree absent on this branch, not a dead worktree"
  [ -d "$rp/home/worktrees/ccc/api" ] && _fail "reap: left the graph of a worktree that is gone"
  rm -rf "$rp"

  # The invariant itself: a cold build through gfx_ensure_graph heals registry,
  # domain and graph, writes the graph OUTSIDE the repo, and leaves the indexed
  # repo byte-unchanged. Needs the CLI, so it cannot run where graphify is absent
  # (CI installs none) - and there it SAYS SO, in the summary line as well as
  # here. A silent skip reads exactly like a pass, which is the failure this whole
  # case exists to prevent: a green run must never be mistakable for a proof that
  # never ran.
  local skipped=
  if command -v graphify >/dev/null 2>&1; then
    local bt btr bhome bgraph
    bt=$(mktemp -d); bhome="$d/bhome"
    ( cd "$bt" && git init -q && printf 'def a():\n    return 1\n' > a.py \
        && git add -A && git -c user.email=t@t -c user.name=t commit -q -m init ) \
      || _fail "cold build: could not init the fixture repo"
    btr=$( cd "$bt" && pwd -P )
    bgraph=$( cd "$bt" && GRAPHIFY_HOME="$bhome" gfx_ensure_graph 2>/dev/null )
    # Where the graph landed, asserted against the TREE and the HOME - not against
    # gfx_out_dir, which is where it came from: both sides of that comparison move
    # together, so it could not see an out dir pointing back inside the repo.
    case "$bgraph" in "$btr"/*) _fail "cold build landed inside the indexed tree: $bgraph" ;; esac
    case "$bgraph" in "$bhome"/*) ;; *) _fail "cold build landed outside the graphify home: $bgraph" ;; esac
    _eq "cold build returns the path gfx_out_dir derives" "$bgraph" \
        "$( cd "$bt" && GRAPHIFY_HOME="$bhome" gfx_out_dir repo )/graph.json"
    jq -e . "$bgraph" >/dev/null 2>&1 || _fail "cold build: graph.json missing or torn"
    # Global excludes neutralised: every machine that ran the retired never-commit
    # guard still carries `graphify-out/` in its global gitignore, which makes a
    # plain `git status` blind to exactly the write this asserts is absent.
    _eq "cold build leaves the indexed repo byte-unchanged" \
        "$( cd "$bt" && git -c core.excludesFile=/dev/null status --porcelain )" ""
    [ -z "$(find "$bt" -name graphify-out -print -quit 2>/dev/null)" ] \
      || _fail "cold build wrote graphify-out inside the indexed repo"
    # A graph left by a DIFFERENT tree at this path is discarded, never served:
    # the out dir outlives the worktree, and a foreign graph is valid JSON.
    local other
    other=$( cd "$bt" && GRAPHIFY_HOME="$bhome" gfx_out_dir repo )
    jq '.built_at_commit="0000000000000000000000000000000000000000"' "$bgraph" >"$d/foreign.json" \
      && cp "$d/foreign.json" "$bgraph"
    ( cd "$bt" && GRAPHIFY_HOME="$bhome" gfx_ensure_graph >/dev/null 2>&1 )
    _eq "a foreign graph at this path is rebuilt, not served" \
        "$( jq -r '.built_at_commit' "$other/graph.json" 2>/dev/null )" \
        "$( cd "$bt" && git rev-parse HEAD )"
    rm -rf "$bt"
  else
    skipped=' (SKIPPED: the cold-build invariant case - no graphify on PATH)'
    printf 'bd-gfx selftest SKIPPED: cold-build invariant case, graphify is not installed here\n' >&2
  fi

  # cross_edges: pkg/a -> pkg/b stays inside one subtree, the other two cross.
  # A root-level file (README.md) is in no subtree and an id with no node resolves
  # to nothing, so neither r -> c nor a -> gone is a crossing.
  local cg; cg=$(mktemp -d)
  printf '%s\n' '{"nodes":[{"id":"a","source_file":"pkg/a.py"},{"id":"b","source_file":"pkg/b.py"},{"id":"c","source_file":"lib/c.py"},{"id":"r","source_file":"README.md"}],"links":[{"source":"a","target":"b"},{"source":"a","target":"c"},{"source":"b","target":"c"},{"source":"r","target":"c"},{"source":"a","target":"gone"}]}' >"$cg/graph.json"
  _eq "cross_edges count" "$( gfx_cross_edges "$cg/graph.json" )" "2"
  # an absolute source_file is in no subtree: it must not become a bucket of its
  # own (a crossing against every relative node) nor a bucket they all share.
  printf '%s\n' '{"nodes":[{"id":"x","source_file":"/w/apps/x.ts"},{"id":"y","source_file":"pkg/y.ts"},{"id":"z","source_file":"/w/lib/z.ts"}],"links":[{"source":"x","target":"y"},{"source":"x","target":"z"}]}' >"$cg/abs.json"
  _eq "cross_edges absolute source_file" "$( gfx_cross_edges "$cg/abs.json" )" "0"
  # torn or absent is not a count: non-zero, stdout empty
  printf '%s\n' '{"nodes":[' >"$cg/torn.json"
  _eq "cross_edges torn stdout" "$( gfx_cross_edges "$cg/torn.json" 2>/dev/null )" ""
  gfx_cross_edges "$cg/torn.json" >/dev/null 2>&1 && _fail "cross_edges torn: expected non-zero"
  gfx_cross_edges "$cg/absent.json" >/dev/null 2>&1 && _fail "cross_edges absent: expected non-zero"
  rm -rf "$cg"

  rm -rf "$d"
  [ "$rc" = 0 ] && printf 'bd-gfx selftest OK%s\n' "$skipped"
  return "$rc"
}

# Sourced -> expose functions only. Executed -> dispatch the argument.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:-}" in
    selftest) _gfx_selftest ;;
    *) printf 'bd-gfx: source this file for helpers, or run: bd-gfx selftest\n' >&2; exit 2 ;;
  esac
fi
