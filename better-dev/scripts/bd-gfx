#!/usr/bin/env bash
# bd-gfx - better-dev's shared graphify helpers.
#   source it:  . "${CLAUDE_PLUGIN_ROOT}/scripts/bd-gfx"
#          or:  . "$repo/.better-dev/bin/bd-gfx"
# Repo-keyed central home holds only the registry; graphs live in-tree
# (gitignored) at <path>/graphify-out/ per graphify's native layout.
# Ported from orrgal1/claude-plugins graphify-wrapper (MIT), see NOTICE.

# Canonical repo id, stable across all worktrees (derived from git identity).
gfx_repo_key() {
  local url
  url=$(git remote get-url origin 2>/dev/null || true)
  if [ -n "$url" ]; then
    printf '%s\n' "$url" | sed -E \
      -e 's#\.git$##' \
      -e 's#^[a-z]+://##' \
      -e 's#^[^@]*@##' \
      -e 's#^[^:/]*[:/]##' \
      -e 's#/#__#g'
  else
    git rev-parse --git-common-dir 2>/dev/null | shasum -a 256 | cut -c1-12
  fi
}

# Central home (registry only). Override with GRAPHIFY_HOME.
gfx_home() { printf '%s\n' "${GRAPHIFY_HOME:-$HOME/.claude/graphify/$(gfx_repo_key)}"; }
gfx_registry() { printf '%s\n' "$(gfx_home)/registry.json"; }

gfx_default_branch() {
  local b
  b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}
  if [ -z "$b" ]; then
    for c in main master; do
      git show-ref -q --verify "refs/remotes/origin/$c" 2>/dev/null && { b=$c; break; }
    done
  fi
  printf '%s\n' "${b:-main}"
}

# Absolute path of the seed source: the primary checkout, which `git worktree list`
# always lists first. Deliberately not "the worktree on the default branch": a
# staged repo defaults to main while its primary checkout stands on staging, so
# that match found nothing and every consumer's [ -n "$main" ] guard silently
# skipped seeding.
# A bare repo has no primary checkout - entry 1 is the bare dir (no working tree,
# no graphs), and the linked worktrees behind it are peers in creation order, none
# canonical. There the default-branch worktree is the seed source; with several
# peers and none on it, the answer is nothing at all, because seeding a checkout
# from whichever peer git listed first is worse than not seeding it.
gfx_main_worktree() {
  git worktree list --porcelain 2>/dev/null | awk -v db="refs/heads/$(gfx_default_branch)" '
    function flush() {
      if (wt == "") return
      rec++
      if (bare) { if (rec == 1) barelayout = 1 }
      else {
        nonbare++
        if (first == "") first = wt
        if (br == db && best == "") best = wt
      }
      wt = ""; br = ""; bare = 0
    }
    /^worktree / { flush(); wt = substr($0, 10); next }
    /^bare$/     { bare = 1; next }
    /^branch /   { br = substr($0, 8); next }
    END {
      flush()
      if (!barelayout)       { if (first != "") print first }
      else if (best != "")     print best
      else if (nonbare == 1)   print first
    }'
}

# Path of the current worktree root.
gfx_this_worktree() { git rev-parse --show-toplevel 2>/dev/null; }

# Backend for --semantic builds; defaults to claude-cli (no API key, plan-billed).
gfx_backend() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.backend // "claude-cli"' "$r" 2>/dev/null && return 0
  fi
  printf 'claude-cli\n'
}

# Model for the claude-cli semantic backend. graphify's claude-cli path defaults
# to Opus (overkill for structured-JSON extraction); we pin sonnet.
gfx_cli_model() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.cli_model // "sonnet"' "$r" 2>/dev/null && return 0
  fi
  printf 'sonnet\n'
}

# File globs excluded from semantic `extract`. graphify reads docs AND images as
# text and asks the LLM to graph them, but SVG markup (path/base64 data) and
# decoded binary bytes are token-heavy noise with zero architectural signal, and
# big image-stuffed chunks are what time out. Default to dropping image/asset
# files; override per-repo with a JSON `.extract_excludes` array in the registry.
gfx_extract_excludes() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ] && jq -e '(.extract_excludes // empty) | type == "array"' "$r" >/dev/null 2>&1; then
    jq -r '.extract_excludes[]' "$r" 2>/dev/null && return 0
  fi
  printf '%s\n' '*.svg' '*.png' '*.jpg' '*.jpeg' '*.gif' '*.webp' '*.bmp' '*.ico' '*.tiff' '*.heic'
}

# Per-chunk token budget for the claude-cli backend. graphify hardcodes the
# `claude -p` subprocess timeout at 600s (--api-timeout governs only HTTP API
# backends), so oversized chunks time out. Cap chunk size below graphify's 60k
# default so each call finishes under the wall. Override with `.cli_token_budget`.
gfx_cli_token_budget() {
  local r; r=$(gfx_registry)
  if [ -f "$r" ]; then
    jq -r '.cli_token_budget // "20000"' "$r" 2>/dev/null && return 0
  fi
  printf '20000\n'
}

# jq read of an index field:  gfx_index_field <name> <field>
gfx_index_field() {
  jq -r --arg n "$1" --arg f "$2" '.indexes[$n][$f] // empty' "$(gfx_registry)" 2>/dev/null
}

gfx_index_names() { jq -r '.indexes | keys[]' "$(gfx_registry)" 2>/dev/null; }

# Resolve a queryable graph, building whatever is missing. Prints the graph.json
# path on stdout, every diagnostic on stderr, so a caller can capture the path.
#
# This exists because the query path used to dead-end: it exited 1 on a missing
# registry, a missing domain, or a missing graph, and the caller silently fell
# back to grep. Three misses down that chain and no repo ever built a graph at
# all, so the capability shipped and never ran. Each miss is now healed in place
# - the first real question is what wires the index up.
#
# The build here is always AST-only: free, no LLM, no API key. A `--semantic`
# layer stays a deliberate `/graphify-wrapper-sync --semantic`, never something
# a question triggers on the operator's behalf.
gfx_ensure_graph() {
  local name="${1:-}" reg root idx_path dst graph tmp
  command -v graphify >/dev/null 2>&1 || {
    printf 'graphify CLI not installed - run /graphify-wrapper-setup\n' >&2; return 1; }
  root=$(gfx_this_worktree)
  [ -n "$root" ] || { printf 'not inside a git worktree\n' >&2; return 1; }
  reg=$(gfx_registry)

  # Miss 1 - no registry: setup never ran here. Write the one it would have.
  if [ ! -f "$reg" ]; then
    mkdir -p "$(dirname "$reg")" || return 1
    jq -n --arg key "$(gfx_repo_key)" --arg main "$(gfx_main_worktree)" \
          --arg branch "$(gfx_default_branch)" \
      '{repo_key:$key, main_worktree:$main, default_branch:$branch,
        backend:"claude-cli", cli_model:"sonnet", indexes:{}}' > "$reg" || return 1
    printf 'graphify: created registry %s\n' "$reg" >&2
  fi

  # Miss 2 - nothing carved: index the whole repo as one domain so the question
  # can be answered now. /graphify-wrapper-map carves it properly once the repo
  # is big enough to earn the split.
  if [ -z "$(gfx_index_names)" ]; then
    [ -n "$name" ] || name=repo
    tmp=$(mktemp "$(dirname "$reg")/.reg.XXXXXX") || return 1
    if jq --arg n "$name" '.indexes[$n]={path:".", semantic:false}' "$reg" > "$tmp"; then
      mv "$tmp" "$reg" || { rm -f "$tmp"; return 1; }
    else
      rm -f "$tmp"; return 1
    fi
    printf 'graphify: no domain registered - indexing the whole repo as "%s" (carve it later with /graphify-wrapper-map)\n' "$name" >&2
  fi

  [ -n "$name" ] || name=$(gfx_index_names | head -1)
  idx_path=$(gfx_index_field "$name" path)
  [ -n "$idx_path" ] || { printf 'unknown index "%s" - see /graphify-wrapper-status\n' "$name" >&2; return 1; }
  case "$idx_path" in .) dst="$root" ;; *) dst="$root/$idx_path" ;; esac
  [ -d "$dst" ] || { printf 'index "%s" path absent in this worktree: %s\n' "$name" "$idx_path" >&2; return 1; }
  graph="$dst/graphify-out/graph.json"

  # Miss 3 - no graph in this worktree. A torn graph.json counts as missing:
  # graphify's shrink guard refuses `update` over one it cannot parse.
  if ! jq -e . "$graph" >/dev/null 2>&1; then
    rm -f "$graph"
    printf 'graphify: no graph for "%s" here - AST build, no LLM\n' "$name" >&2
    graphify update "$dst" >&2 || { printf 'graphify build failed for "%s"\n' "$name" >&2; return 1; }
  fi
  jq -e . "$graph" >/dev/null 2>&1 || { printf 'graph still unusable after build: %s\n' "$graph" >&2; return 1; }
  printf '%s\n' "$graph"
}

# Links whose two endpoints live in different top-level subtrees of the indexed
# path:  gfx_cross_edges <graph.json>  -> one integer on stdout. A cheap read of
# how much a domain's structure crosses its own seams.
#
# Only endpoints that resolve to a subtree count. A node whose source_file has no
# `/` is a root-level file, in no subtree at all, and an endpoint id with no node
# resolves to nothing - counting either inflates the number the operator makes a
# split/keep decision on (this repo's own graph reported 7 where 1 was real).
#
# A graph.json that exists is not a graph.json that parses (graphify leaves torn
# output behind on an interrupted build), so this guards first the way
# gfx_ensure_graph does. Missing, torn, or not shaped like a graph -> non-zero
# and nothing on stdout, never a jq diagnostic passed off as a count.
gfx_cross_edges() {
  local graph="${1:-}"
  jq -e . "$graph" >/dev/null 2>&1 || return 1
  jq -r '(reduce .nodes[] as $n ({};
            .[$n.id] = (($n.source_file // "") | split("/")
                        | if length > 1 then .[0] else null end))) as $sub
    | [.links[] | select($sub[.source] != null and $sub[.target] != null
                         and $sub[.source] != $sub[.target])] | length' \
    "$graph" 2>/dev/null
}

# --- selftest -------------------------------------------------------------
# Runs only when this file is EXECUTED, never when sourced. Offline checks of
# the helpers above against throwaway git repos and registries under mktemp.
_gfx_selftest() {
  local d rc=0
  d=$(mktemp -d)
  # shellcheck disable=SC2317
  _fail() { printf 'bd-gfx selftest FAIL: %s\n' "$1" >&2; rc=1; }
  _eq() { [ "$2" = "$3" ] || _fail "$1: expected '$3', got '$2'"; }

  # repo key from an ssh remote
  ( cd "$d" && git init -q && git remote add origin git@github.com:acme/mono.git )
  _eq "ssh repo_key" "$( cd "$d" && gfx_repo_key )" "acme__mono"
  # same repo, https remote form yields the same key
  ( cd "$d" && git remote set-url origin https://github.com/acme/mono.git )
  _eq "https repo_key" "$( cd "$d" && gfx_repo_key )" "acme__mono"

  # no-remote repo hashes to a 12-char hex string
  local nr key
  nr=$(mktemp -d); ( cd "$nr" && git init -q )
  key=$( cd "$nr" && gfx_repo_key )
  [[ "$key" =~ ^[0-9a-f]{12}$ ]] || _fail "no-remote repo_key: not 12 hex, got '$key'"
  rm -rf "$nr"

  # gfx_home honours GRAPHIFY_HOME, else falls under $HOME/.claude/graphify/<key>
  _eq "gfx_home override" "$( cd "$d" && GRAPHIFY_HOME=/tmp/x gfx_home )" "/tmp/x"
  _eq "gfx_home default" "$( cd "$d" && unset GRAPHIFY_HOME; gfx_home )" \
      "$HOME/.claude/graphify/acme__mono"

  # defaults with no registry file present
  local h; h=$(mktemp -d)
  _eq "default backend"       "$( GRAPHIFY_HOME="$h" gfx_backend )"          "claude-cli"
  _eq "default cli_model"     "$( GRAPHIFY_HOME="$h" gfx_cli_model )"        "sonnet"
  _eq "default token_budget"  "$( GRAPHIFY_HOME="$h" gfx_cli_token_budget )" "20000"
  _eq "default excludes[0]"   "$( GRAPHIFY_HOME="$h" gfx_extract_excludes | head -1 )" "*.svg"
  rm -rf "$h"

  # values read from a registry file
  local rh; rh=$(mktemp -d)
  printf '%s\n' '{"backend":"api","indexes":{"a":{"path":"pkg/a"}}}' >"$rh/registry.json"
  _eq "registry backend"     "$( GRAPHIFY_HOME="$rh" gfx_backend )"              "api"
  _eq "registry index_names" "$( GRAPHIFY_HOME="$rh" gfx_index_names )"          "a"
  _eq "registry index_field" "$( GRAPHIFY_HOME="$rh" gfx_index_field a path )"   "pkg/a"
  rm -rf "$rh"

  # backend falls back to claude-cli when the registry carries no backend key
  local bh; bh=$(mktemp -d)
  printf '%s\n' '{"indexes":{}}' >"$bh/registry.json"
  _eq "backend no-key default" "$( GRAPHIFY_HOME="$bh" gfx_backend )" "claude-cli"
  rm -rf "$bh"

  # default_branch: an origin/HEAD symbolic ref wins
  local db; db=$(mktemp -d)
  ( cd "$db" && git init -q \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && git update-ref refs/remotes/origin/develop HEAD \
      && git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/develop )
  _eq "default_branch origin/HEAD" "$( cd "$db" && gfx_default_branch )" "develop"
  rm -rf "$db"

  # default_branch: no origin/HEAD, but refs/remotes/origin/main present
  local dm; dm=$(mktemp -d)
  ( cd "$dm" && git init -q \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && git update-ref refs/remotes/origin/main HEAD )
  _eq "default_branch origin/main" "$( cd "$dm" && gfx_default_branch )" "main"
  rm -rf "$dm"

  # default_branch: nothing to go on -> main
  local dn; dn=$(mktemp -d); ( cd "$dn" && git init -q )
  _eq "default_branch fallback" "$( cd "$dn" && gfx_default_branch )" "main"
  rm -rf "$dn"

  # main_worktree: on the default branch it prints this worktree's root
  local mw; mw=$(mktemp -d)
  ( cd "$mw" && git init -q && git symbolic-ref HEAD refs/heads/main \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init )
  _eq "main_worktree is this" \
      "$( cd "$mw" && gfx_main_worktree )" "$( cd "$mw" && gfx_this_worktree )"
  rm -rf "$mw"

  # main_worktree: staged shape - default branch main, primary checkout standing
  # on staging. No worktree is on main at all, and the seed source is still here.
  local sw; sw=$(mktemp -d)
  ( cd "$sw" && git init -q \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && git update-ref refs/remotes/origin/main HEAD \
      && git checkout -q -b staging )
  _eq "main_worktree on staged repo" \
      "$( cd "$sw" && gfx_main_worktree )" "$( cd "$sw" && gfx_this_worktree )"
  rm -rf "$sw"

  # main_worktree: from a LINKED worktree - where every consumer's seed guard
  # actually runs - it points back at the primary checkout, not at itself.
  local lw; lw=$(mktemp -d)
  ( cd "$lw" && git init -q primary && cd primary \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && git worktree add -q ../feat -b feat/x )
  _eq "main_worktree from linked wt" \
      "$( cd "$lw/feat" && gfx_main_worktree )" "$( cd "$lw/primary" && gfx_this_worktree )"
  rm -rf "$lw"

  # main_worktree: bare-repo layout - entry 1 is the bare dir (no working tree,
  # no graphs), so the one linked worktree behind it is the seed source.
  local bw; bw=$(mktemp -d)
  ( cd "$bw" && git init -q src && cd src \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && cd "$bw" && git clone -q --bare src repo.git \
      && cd repo.git && git worktree add -q ../wt -b wt HEAD )
  _eq "main_worktree on bare layout" \
      "$( cd "$bw/wt" && gfx_main_worktree )" "$( cd "$bw/wt" && gfx_this_worktree )"
  rm -rf "$bw"

  # main_worktree: bare layout with SEVERAL linked worktrees. Creation order puts
  # the feature worktree first, so "first working tree" seeds every peer from a
  # feature branch - and from that peer itself returns itself, which reads as
  # "nothing to seed from". The default-branch checkout is the answer from both.
  local bm; bm=$(mktemp -d)
  ( cd "$bm" && git init -q src && cd src && git symbolic-ref HEAD refs/heads/main \
      && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m init \
      && cd "$bm" && git clone -q --bare src repo.git && cd repo.git \
      && git worktree add -q ../feat -b feat/x HEAD \
      && git worktree add -q ../mainwt main )
  _eq "main_worktree on bare layout, from a feature worktree" \
      "$( cd "$bm/feat" && gfx_main_worktree )" "$( cd "$bm/mainwt" && gfx_this_worktree )"
  _eq "main_worktree on bare layout, from the default-branch worktree" \
      "$( cd "$bm/mainwt" && gfx_main_worktree )" "$( cd "$bm/mainwt" && gfx_this_worktree )"
  rm -rf "$bm"

  # cross_edges: pkg/a -> pkg/b stays inside one subtree, the other two cross.
  # A root-level file (README.md) is in no subtree and an id with no node resolves
  # to nothing, so neither r -> c nor a -> gone is a crossing.
  local cg; cg=$(mktemp -d)
  printf '%s\n' '{"nodes":[{"id":"a","source_file":"pkg/a.py"},{"id":"b","source_file":"pkg/b.py"},{"id":"c","source_file":"lib/c.py"},{"id":"r","source_file":"README.md"}],"links":[{"source":"a","target":"b"},{"source":"a","target":"c"},{"source":"b","target":"c"},{"source":"r","target":"c"},{"source":"a","target":"gone"}]}' >"$cg/graph.json"
  _eq "cross_edges count" "$( gfx_cross_edges "$cg/graph.json" )" "2"
  # torn or absent is not a count: non-zero, stdout empty
  printf '%s\n' '{"nodes":[' >"$cg/torn.json"
  _eq "cross_edges torn stdout" "$( gfx_cross_edges "$cg/torn.json" 2>/dev/null )" ""
  gfx_cross_edges "$cg/torn.json" >/dev/null 2>&1 && _fail "cross_edges torn: expected non-zero"
  gfx_cross_edges "$cg/absent.json" >/dev/null 2>&1 && _fail "cross_edges absent: expected non-zero"
  rm -rf "$cg"

  rm -rf "$d"
  [ "$rc" = 0 ] && printf 'bd-gfx selftest OK\n'
  return "$rc"
}

# Sourced -> expose functions only. Executed -> dispatch the argument.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:-}" in
    selftest) _gfx_selftest ;;
    *) printf 'bd-gfx: source this file for helpers, or run: bd-gfx selftest\n' >&2; exit 2 ;;
  esac
fi
