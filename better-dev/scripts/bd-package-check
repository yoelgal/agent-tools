#!/usr/bin/env bash
# bd-package-check - validate the whole better-dev package before install or release.
#
# Lints every skill (frontmatter minimal + name==folder + "Use when" description + no @-links + calm
# voice), runs every helper's selftest, validates the JSON manifests, and checks that backtick-wrapped
# /skill references resolve (to a shipped skill or a known host-optional builtin). Non-zero exit on any
# failure - a release / CI gate, and what `/self-extension` runs before promoting a freshly authored skill.
set -uo pipefail

# Package root = the dir holding skills/ + scripts/ (run from anywhere in the dev repo).
ROOT="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
[ -d "$ROOT/skills" ] || ROOT="$(pwd)"
cd "$ROOT"

fail=0
ok()  { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=1; }

# --- prove-new: every check a diff adds must have been red before its implementation ------------
#
# A check that is green before the thing it guards exists proves nothing, and reads exactly like one
# that works. Three shipped in a single work-item before this existed. The rule: for every ok/bad
# label the diff adds, run the CURRENT script against the BASE tree and require that label to come
# back red. Green at base means the check was vacuous; absent at base means it silently skipped,
# which is no better. A check that legitimately holds at base (a regression guard) says so on the
# line and is exempted by name, never silently.

# Longest run of literal text in a label, so an interpolated label still matches its printed line.
_static_run() {
  awk -v s="$1" 'BEGIN{
    gsub(/\$\([^)]*\)/, "\001", s)
    gsub(/\$\{[^}]*\}/, "\001", s)
    gsub(/\$[A-Za-z_][A-Za-z0-9_]*/, "\001", s)
    n = split(s, parts, "\001"); b = ""
    for (i = 1; i <= n; i++) if (length(parts[i]) > length(b)) b = parts[i]
    gsub(/^[ \t]+|[ \t]+$/, "", b)
    print b
  }'
}

# (repo root, script path relative to it, base ref) - parameterized so the fixtures below can point
# it at a stub. Running the real gate inside a fixture repo would fail for unrelated reasons.
# A check's ok-label and bad-label are different strings, and at base a check that FAILS prints its
# bad-label. Matching ok-labels alone would read every genuinely-red check as "absent", so the two
# are paired: an OK token immediately followed by a BAD token is one check, which is how every
# `cond && ok "..." || bad "..."` in this file is written.
#
# Only TOP-LEVEL call sites count. Every real check in this file is top level; ok/bad text also
# appears inside function bodies (this mode's own findings) and inside heredocs (its fixtures), and
# counting those makes the mode trip over its own source. Line numbers come from the file at HEAD,
# then get intersected with the lines the diff actually added.
_check_tokens() {
  local root="$1" script_rel="$2" base="$3" addedlines
  addedlines="$(git -C "$root" diff --unified=0 "$base" -- "$script_rel" \
    | awk '/^@@/ { if (match($0, /\+[0-9]+(,[0-9]+)?/)) {
              spec = substr($0, RSTART + 1, RLENGTH - 1)
              n = split(spec, a, ","); start = a[1] + 0; count = (n > 1 ? a[2] + 0 : 1)
              for (i = 0; i < count; i++) print start + i } }' | tr '\n' ' ')"
  case "$addedlines" in *[0-9]*) ;; *) return 0 ;; esac
  awk -v added="$addedlines" '
    BEGIN { n = split(added, arr, " "); for (i = 1; i <= n; i++) if (arr[i] != "") want[arr[i] + 0] = 1 }
    {
      line = $0
      # A comment naming ok "..." while explaining the rule is not a check. This very file has one.
      if (line ~ /^[ \t]*#/) next
      if (heredoc != "") { if (line == heredoc || line == heredoc "\n") heredoc = ""; next }
      if (match(line, /<<[-]?'"'"'?[A-Za-z_][A-Za-z0-9_]*'"'"'?/)) {
        d = substr(line, RSTART, RLENGTH); gsub(/^<<-?'"'"'?|'"'"'$/, "", d); heredoc = d; next
      }
      # A one-liner definition (helper() { ...; }) opens and closes on the same line, so it must not
      # flip the in-function state - doing so swallows every real check below it.
      if (line ~ /^[A-Za-z_][A-Za-z0-9_]*\(\)[ \t]*\{/) { if (line !~ /\}[ \t]*$/) infunc = 1; next }
      if (infunc && line ~ /^\}/) { infunc = 0; next }
      if (infunc) next
      if (!(NR in want)) next
      reason = ""
      if (match(line, /# prove-new: regression-guard[ \t]*/)) {
        reason = substr(line, RSTART + RLENGTH); line = substr(line, 1, RSTART - 1)
      }
      rest = line
      while (match(rest, /(^|[^A-Za-z0-9_])(ok|bad)[ \t]+"[^"]*"/)) {
        tok = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
        kind = (tok ~ /ok[ \t]+"/) ? "OK" : "BAD"
        sub(/^[^"]*"/, "", tok); sub(/"$/, "", tok)
        t++; tk[t] = kind; tl[t] = tok; tr[t] = reason
      }
    }
    # Pair here rather than in the shell: one record per CHECK keeps the caller free of arrays and
    # process substitution, both of which the repo pre-commit hook rejects via sh -n.
    END {
      i = 1
      while (i <= t) {
        if (tk[i] == "OK" && tk[i + 1] == "BAD") { printf "%s\n%s\n%s\n", tl[i], tl[i + 1], tr[i]; i += 2 }
        else if (tk[i] == "OK")                  { printf "%s\n\n%s\n",    tl[i], tr[i];            i += 1 }
        else                                     { printf "\n%s\n%s\n",    tl[i], tr[i];            i += 1 }
      }
    }' "$root/$script_rel"
}

# (repo root, script path relative to it, base ref) - parameterized so the fixtures below can point
# it at a stub. Running the real gate inside a fixture repo would fail for unrelated reasons.
prove_new() {
  local root="$1" script_rel="$2" base="$3"
  local tmp base_out n_bad=0 checks

  git -C "$root" rev-parse --verify --quiet "$base" >/dev/null \
    || { printf 'prove-new: bad base ref: %s\n' "$base" >&2; return 1; }

  checks="$(mktemp)"
  _check_tokens "$root" "$script_rel" "$base" > "$checks"
  if [ ! -s "$checks" ]; then
    rm -f "$checks"
    ok "prove-new: this diff adds no checks"
    return 0
  fi

  tmp="$(mktemp -d)"
  git -C "$root" archive "$base" 2>/dev/null | tar -x -C "$tmp" 2>/dev/null
  mkdir -p "$tmp/$(dirname "$script_rel")"
  cp "$root/$script_rel" "$tmp/$script_rel"
  chmod +x "$tmp/$script_rel"
  base_out="$( (cd "$tmp" && "./$script_rel" 2>&1) | sed 's/'$'\033''\[[0-9;]*m//g' )"
  rm -rf "$tmp"

  # Matches the label's longest literal run against a base line, and reports that line's mark.
  _mark_at_base() {
    local static line
    static="$(_static_run "$1")"
    [ "${#static}" -ge 8 ] || { printf 'SHORT'; return; }
    line="$(printf '%s\n' "$base_out" | grep -F -- "$static" | head -1)"
    case "$line" in
      *"✗"*) printf 'RED' ;;
      *"✓"*) printf 'GREEN' ;;
      *)     printf 'ABSENT' ;;
    esac
  }

  local oklab badlab why
  while IFS= read -r oklab && IFS= read -r badlab && IFS= read -r why; do
    [ -n "$oklab$badlab" ] || continue

    if [ -n "$why" ]; then
      ok "prove-new: EXEMPT [$(_static_run "${oklab:-$badlab}")] - regression-guard: $why"
      continue
    fi

    local okmark="" badmark=""
    [ -n "$oklab" ] && okmark="$(_mark_at_base "$oklab")"
    [ -n "$badlab" ] && badmark="$(_mark_at_base "$badlab")"
    local shown; shown="$(_static_run "${oklab:-$badlab}")"

    if [ "$okmark" = SHORT ] || { [ -z "$oklab" ] && [ "$badmark" = SHORT ]; }; then
      bad "prove-new: UNKNOWN [${oklab:-$badlab}] - no distinctive literal text to match at base; give the label a fixed phrase"
      n_bad=$((n_bad + 1))
    elif [ "$okmark" = GREEN ]; then
      bad "prove-new: UNPROVEN [$shown] - already green at base, so it never proved anything"
      n_bad=$((n_bad + 1))
    elif [ "$badmark" = RED ]; then
      ok "prove-new: PROVEN [$shown] - red at base"
    else
      bad "prove-new: UNPROVEN [$shown] - never ran at base, so it skipped rather than failed"
      n_bad=$((n_bad + 1))
    fi
  done < "$checks"
  rm -f "$checks"

  [ "$n_bad" = 0 ]
}

# /refs a skill may compose from the host but better-dev does not ship.
HOST_OPTIONAL="code-review security-review verify domain-modeling"

# Fixtures for prove-new. A stub script inside a throwaway repo, not the real gate: running the real
# gate in a fixture tree would fail for a dozen unrelated reasons and prove nothing about the mode.
prove_new_selftest() {
  local fx rc=0 out base
  fx="$(mktemp -d)"
  (
    cd "$fx" || exit 1
    git init -q . && git config user.email t@t && git config user.name t
    mkdir -p scripts
    cat > scripts/stub <<'STUB'
#!/usr/bin/env bash
ok()  { printf '  \342\234\223 %s\n' "$*"; }
bad() { printf '  \342\234\227 %s\n' "$*"; }
ok "a pre-existing check nobody touched"
STUB
    chmod +x scripts/stub
    git add -A && git commit -qm base
  ) || { printf 'prove-new selftest: fixture setup failed\n' >&2; rm -rf "$fx"; return 1; }
  base="$(git -C "$fx" rev-parse HEAD)"

  # HEAD adds one check of every classification the mode has to tell apart.
  cat > "$fx/scripts/stub" <<'STUB'
#!/usr/bin/env bash
ok()  { printf '  \342\234\223 %s\n' "$*"; }
bad() { printf '  \342\234\227 %s\n' "$*"; }
ok "a pre-existing check nobody touched"
ok "an unconditional vacuous claim"
[ -f marker.txt ] && ok "a genuine guarded new check" || bad "a genuine guarded new check missing"
if [ -f marker.txt ]; then ok "a check that skips itself at base"; fi
ok "$x-$y"
ok "an invariant that already held"   # prove-new: regression-guard the tree already satisfied this
STUB
  : > "$fx/marker.txt"
  ( cd "$fx" && git add -A && git commit -qm head ) >/dev/null 2>&1

  out="$(prove_new "$fx" "scripts/stub" "$base" 2>&1)"
  local o="$out"
  printf '%s' "$o" | grep -q 'UNPROVEN.*an unconditional vacuous claim' \
    || { bad "prove-new selftest: a vacuous check was not flagged UNPROVEN"; rc=1; }
  printf '%s' "$o" | grep -q 'PROVEN.*a genuine guarded new check' \
    || { bad "prove-new selftest: a genuine red-at-base check was not cleared as PROVEN"; rc=1; }
  printf '%s' "$o" | grep -q 'UNPROVEN.*a check that skips itself at base' \
    || { bad "prove-new selftest: a check absent at base was not flagged UNPROVEN"; rc=1; }
  printf '%s' "$o" | grep -q 'UNKNOWN' \
    || { bad "prove-new selftest: an unattributable label was not flagged UNKNOWN"; rc=1; }
  printf '%s' "$o" | grep -q 'EXEMPT.*the tree already satisfied this' \
    || { bad "prove-new selftest: a regression-guard was not exempted and named"; rc=1; }
  prove_new "$fx" "scripts/stub" "$base" >/dev/null 2>&1 \
    && { bad "prove-new selftest: the mode exited 0 with unproven checks present"; rc=1; }

  [ $rc = 0 ] && ok "prove-new: discriminates vacuous / genuine / skipped / unattributable / exempt"
  rm -rf "$fx"
  return $rc
}

# Same integration-branch walk bd-review-package uses, so one repo has one idea of what BASE means.
_default_base() {
  local ref
  for ref in staging origin/staging origin/main main; do
    git rev-parse --verify --quiet "$ref" >/dev/null && { git merge-base "$ref" HEAD && return 0; }
  done
  git rev-parse --verify --quiet HEAD~1 >/dev/null && { git rev-parse HEAD~1; return 0; }
  printf 'prove-new: no staging/main/HEAD~1 to derive a base from - pass one explicitly\n' >&2
  return 1
}

case "${1:-}" in
  selftest)   prove_new_selftest; exit $? ;;
  # [base] [root] - the root override exists so this can be pointed at another checkout (auditing a
  # past commit) without copying anything into it, which would make the diff read its own overlay.
  --prove-new)
    shift
    prove_new "${2:-$ROOT}" "scripts/bd-package-check" "${1:-$(_default_base)}"; exit $? ;;
esac

# SKILL body with frontmatter, fenced code, inline code, and quoted spans removed - so a backticked
# `@AGENTS.md` or a quoted "MUST" (naming a token to forbid it) doesn't read as a real violation.
prose_of() {
  awk 'NR==1&&$0=="---"{f=1;next} f&&$0=="---"{f=0;b=1;next} b{print}' "$1" \
    | awk '/^```/{c=!c;next} !c{print}' \
    | sed 's/`[^`]*`//g; s/"[^"]*"//g'
}

echo "== skills =="
for f in skills/*/SKILL.md; do
  [ -f "$f" ] || continue
  dir="$(basename "$(dirname "$f")")"
  fm="$(awk 'NR==1&&$0=="---"{f=1;next} f&&$0=="---"{exit} f{print}' "$f")"
  name="$(printf '%s\n' "$fm" | awk -F': *' '/^name:/{print $2; exit}')"
  desc="$(printf '%s\n' "$fm" | sed -n 's/^description: *//p' | head -1)"
  prose="$(prose_of "$f")"
  errs=""
  [ "$name" = "$dir" ] || errs="$errs name!=dir($name)"
  [ -n "$desc" ] || errs="$errs no-description"
  case "$desc" in "Use when"*) ;; *) errs="$errs desc-not-'Use when'";; esac
  ah="$(printf '%s\n' "$fm" | sed -n 's/^argument-hint: *//p' | head -1)"
  case "$ah" in ""|\"*|\'*) ;; \[*|\{*) errs="$errs argument-hint-must-be-a-quoted-string" ;; esac
  printf '%s' "$prose" | grep -qE '(^|[^A-Za-z0-9])@[A-Za-z0-9_./-]+\.(md|sh)' && errs="$errs @-link"
  printf '%s' "$prose" | grep -qE '\b(MUST|ALWAYS|STOP|CRITICAL|SHALL)\b' && errs="$errs shouting"
  [ -z "$errs" ] && ok "$dir" || bad "$dir:$errs"
done

echo "== helper scripts (selftest) =="
for s in scripts/bd-*; do
  [ "$(basename "$s")" = "bd-package-check" ] && continue
  b="$(basename "$s")"
  [ -x "$s" ] || { bad "$b not executable"; continue; }
  "$s" selftest >/dev/null 2>&1 && ok "$b" || bad "$b selftest FAILED"
done

echo "== hook scripts (selftest) =="
for s in hooks/bd-*; do
  [ -e "$s" ] || continue
  b="$(basename "$s")"
  [ -x "$s" ] && "$s" selftest >/dev/null 2>&1 && ok "$b" || bad "$b selftest FAILED"
done

echo "== manifests (valid JSON) =="
for j in .claude-plugin/plugin.json hooks/hooks.json; do
  [ -f "$j" ] || { bad "$j missing"; continue; }
  jq -e . "$j" >/dev/null 2>&1 && ok "$j" || bad "$j invalid JSON"
done

echo "== host adapters =="
# hosts/ is the single host registry (install.sh and bd-uninstall enumerate it), so a broken adapter
# ships breakage to a user machine unless it fails here: source-clean, required fields, name equals
# filename, skills dir under HOME, no two hosts claiming one dir, dir-policy in its enum.
seen_dirs=""
for a in hosts/*; do
  [ -f "$a" ] || continue
  h="$(basename "$a")"
  bd_host_name=""; bd_host_display=""; bd_host_cli=""; bd_host_skills_dir=""; bd_host_dir_policy=""
  if ! . "./$a" 2>/dev/null; then bad "hosts/$h does not source cleanly"; continue; fi
  errs=""
  [ "$bd_host_name" = "$h" ]         || errs="$errs name!=filename($bd_host_name)"
  [ -n "$bd_host_display" ]          || errs="$errs no-display"
  [ -n "$bd_host_cli" ]              || errs="$errs no-cli"
  case "$bd_host_skills_dir" in "$HOME"/*) ;; *) errs="$errs skills-dir-not-under-HOME" ;; esac
  case "$bd_host_dir_policy" in ""|create|require-existing) ;; *) errs="$errs bad-dir-policy($bd_host_dir_policy)" ;; esac
  case " $seen_dirs " in *" $bd_host_skills_dir "*) errs="$errs duplicate-skills-dir" ;; esac
  seen_dirs="$seen_dirs $bd_host_skills_dir"
  [ -z "$errs" ] && ok "hosts/$h" || bad "hosts/$h:$errs"
done

echo "== link sites =="
# Static invariant: every link site routes through _link_or_copy (install.sh) / link_or_copy (bd-link),
# the one place carrying the Windows copy fallback. A raw ln anywhere else regresses that silently.
raw=""
for f in install.sh scripts/*; do
  [ -f "$f" ] || continue
  [ "$(basename "$f")" = "bd-package-check" ] && continue   # this file names the pattern it greps for
  n="$(grep -c 'ln -s' "$f" 2>/dev/null || true)"
  allowed=0
  case "$f" in install.sh|scripts/bd-link) allowed=1 ;; esac   # exactly the helper body's one call
  [ "${n:-0}" -gt "$allowed" ] && raw="$raw $f"
done
[ -z "$raw" ] && ok "every link site routes through the symlink-or-copy helper" \
  || bad "raw ln outside the helper in:$raw (route new link sites through _link_or_copy)"

# Informational only: a backtick `/word` is used for real skill invocations, but also for illustrative
# examples, placeholders (`/name`), URL paths (`/dashboard`), and flow names (`/learn`) - too ambiguous to
# gate on. Surface unknowns for a human glance; don't fail the build.
echo "== cross-skill /refs (informational) =="
present="$(ls skills/ 2>/dev/null | tr '\n' ' ')"
unknown=""
for ref in $(grep -rhoE '`/[a-z][a-z-]+`' skills/*/SKILL.md 2>/dev/null | tr -d '`/' | sort -u); do
  case " $present $HOST_OPTIONAL " in *" $ref "*) ;; *) unknown="$unknown $ref" ;; esac
done
[ -z "$unknown" ] && ok "every backtick /ref is a shipped or host-optional skill" \
  || printf '  \033[33m•\033[0m illustrative/placeholder /refs (not gated):%s\n' "$unknown"

echo "== em/en dash gate =="
# Standing repo rule: no em (U+2014) or en (U+2013) dashes in shipped text. Match the raw UTF-8 bytes
# under LC_ALL=C so this holds on BSD grep (no -P) as well as GNU. Covers the shipped surfaces.
em="$(printf '\342\200\224')"; en="$(printf '\342\200\223')"
dash_hits=""
# The authored files inside the vendored daemon trees are under the no-dash rule too; the upstream .ts
# sources are not (their comments legitimately carry dashes), so scan only what we wrote. Each `ls` is
# its own existence guard - absent on a consumer install that did not vendor them.
vendored_authored="browse/README.md browse/UPSTREAM browse/scripts/check-upstream.sh ios-qa/README.md ios-qa/UPSTREAM ios-qa/scripts/check-upstream.sh"
for f in $(find skills scripts docs hooks hosts -type f 2>/dev/null; ls install.sh README.md BOOTSTRAP.md $vendored_authored 2>/dev/null); do
  LC_ALL=C grep -lq -e "$em" -e "$en" "$f" 2>/dev/null && dash_hits="$dash_hits $f"
done
[ -z "$dash_hits" ] && ok "no em/en dashes in shipped text" || bad "em/en dash in:$dash_hits"

echo "== vendored daemons (lint-shape only) =="
# The vendored daemon trees (browse/, ios-qa/) are NOT behaviorally CI-gated here: this lints their dir
# shape only. Each must carry its provenance (UPSTREAM), license (LICENSE-upstream), and README.md, and
# must commit no build output (node_modules/ or dist/ - git-tracked, not just on disk). A consumer install
# may not vendor these dirs, so skip silently when absent.
for vd in browse ios-qa; do
  [ -d "$vd" ] || continue
  errs=""
  for req in UPSTREAM LICENSE-upstream README.md; do
    [ -f "$vd/$req" ] || errs="$errs missing-$req"
  done
  git ls-files "$vd" 2>/dev/null | grep -qE '(^|/)(node_modules|dist)/' && errs="$errs committed-build-output"
  [ -z "$errs" ] && ok "$vd/ vendored shape ok (lint-shape only, not behaviorally CI-gated)" \
    || bad "$vd/:$errs"
done

echo "== manifest version =="
v="$(jq -r '.version // empty' .claude-plugin/plugin.json 2>/dev/null)"
[ -n "$v" ] && ok "plugin.json version present ($v)" || bad "plugin.json has no non-empty version"

echo "== entry-skill utterances =="
# Each entry skill's description should carry at least one phrase a real user would type for that need,
# so natural-language activation routes without a skill name. Any-of match, case-insensitive.
utt() {
  sk="$1"; shift
  d="$(sed -n 's/^description: *//p' "skills/$sk/SKILL.md" 2>/dev/null | head -1 | tr 'A-Z' 'a-z')"
  for p in "$@"; do case "$d" in *"$p"*) return 0 ;; esac; done
  bad "entry skill '$sk': description names no canonical user phrasing (want one of: $*)"
}
utt plan-grill    "feature" "build" "new feature"
utt diagnose      "bug" "broken" "failing" "crash" "flaky" "slow" "regression"
utt groundwork    "greenfield" "new project" "from scratch" "foundation"
utt pr-and-verify "pull request" "open a pr" " pr "
[ $fail = 0 ] && ok "entry skills carry canonical user phrasings" || true

echo "== install/uninstall roundtrip (every adapter) =="
# Prove the two lifecycle deliverables stay honest for every registered host: a clean HOME installs,
# links resolve, a planted foreign skill is left alone, and bd-uninstall removes only ours. Pre-creating
# the skills dir satisfies require-existing hosts, so the same loop covers both dir policies.
for a in hosts/*; do
  [ -f "$a" ] || continue
  h="$(basename "$a")"
  rt="$(mktemp -d)"
  hd="$(HOME="$rt" bash -c 'source "$1" && printf %s "$bd_host_skills_dir"' _ "$a" 2>/dev/null)"
  if [ -z "$hd" ]; then bad "roundtrip $h: adapter yields no skills dir"; rm -rf "$rt"; continue; fi
  mkdir -p "$hd/review"; printf 'not ours\n' > "$hd/review/SKILL.md"
  if HOME="$rt" "$ROOT/install.sh" --host "$h" >/dev/null 2>&1 \
     && [ -L "$hd/packaging" ] \
     && [ -f "$hd/.better-dev-install" ] \
     && [ ! -L "$hd/review" ] \
     && HOME="$rt" "$ROOT/scripts/bd-uninstall" global --host "$h" --yes >/dev/null 2>&1 \
     && [ ! -e "$hd/packaging" ] \
     && [ ! -f "$hd/.better-dev-install" ] \
     && [ -f "$hd/review/SKILL.md" ]; then
    ok "roundtrip $h: install links resolve, uninstall cleans ours, foreign skill survives"
  else
    bad "install/uninstall roundtrip: $h"
  fi
  rm -rf "$rt"
done

echo "== require-existing decline (skills dir absent) =="
# The roundtrip above pre-creates every skills dir, so require-existing's DECLINE branch never runs there.
# Cover it directly: for one require-existing host with its skills dir ABSENT, install must decline without
# creating the dir and without linking anything. (Known install.sh defect, owned by another worker: the
# decline branch still does installed++, so a declined host is miscounted as installed - asserted on the
# observable dir side here, not the counter.)
re_host=""; re_adapter=""
for a in hosts/*; do
  [ -f "$a" ] || continue
  pol="$(HOME=/nonexistent bash -c 'source "$1" && printf %s "${bd_host_dir_policy:-require-existing}"' _ "$a" 2>/dev/null)"
  [ "$pol" = "require-existing" ] && { re_host="$(basename "$a")"; re_adapter="$a"; break; }
done
if [ -z "$re_host" ]; then
  ok "no require-existing host registered (decline path N/A)"
else
  rt="$(mktemp -d)"
  hd="$(HOME="$rt" bash -c 'source "$1" && printf %s "$bd_host_skills_dir"' _ "$re_adapter" 2>/dev/null)"
  rm -rf "$hd"   # ensure the skills dir is absent
  HOME="$rt" "$ROOT/install.sh" --host "$re_host" >/dev/null 2>&1
  if [ ! -d "$hd" ] && [ ! -f "$hd/.better-dev-install" ]; then
    ok "require-existing $re_host: install declined, skills dir not created, nothing linked"
  else
    bad "require-existing $re_host: install did not decline with skills dir absent (dir or marker present)"
  fi
  rm -rf "$rt"
fi

echo
[ $fail = 0 ] && echo "package-check: PASS ($(ls skills/ | wc -l | tr -d ' ') skills)" || { echo "package-check: FAIL"; exit 1; }
